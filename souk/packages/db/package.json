{
  "name": "@souk/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "studio": "prisma studio",
    "seed": "node --env-file=.env --experimental-strip-types prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file=.env --experimental-strip-types scripts/smoke.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@souk/core": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "typescript": "^5.9.2",
    "@types/node": "^22.10.2"
  }
}
