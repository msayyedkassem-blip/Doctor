<?xml version="1.0" encoding="utf-8"?>
<!--
  The clinic server is reached over plain HTTP on the local network. Android
  forbids that by default, so it is permitted explicitly here.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
