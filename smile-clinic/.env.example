# Copy to .env and adjust, or just export these before `npm start`.
# Nothing here is required — the defaults work for a single-machine install.

PORT=4000
HOST=0.0.0.0

# Where clinic.db lives. Back this folder up.
DATA_DIR=./data

# How long a sign-in lasts before it has to be renewed.
SESSION_DAYS=7

# Set to 1 when the app is served over HTTPS (behind a reverse proxy).
SECURE_COOKIES=0

# Only used on the very first run, when the database has no users yet.
# Leave ADMIN_PASSWORD unset to have one generated and printed once.
ADMIN_EMAIL=admin@clinic.local
# ADMIN_PASSWORD=

# Set to 1 to silence per-request logging.
QUIET=0
